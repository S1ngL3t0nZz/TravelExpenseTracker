<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TravelExpenseTracker" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#6750A4</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#EADDFF</item>
        <item name="colorOnPrimaryContainer">#21005D</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">#625B71</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E8DEF8</item>
        <item name="colorOnSecondaryContainer">#1D192B</item>

        <!-- Tertiary brand color. -->
        <item name="colorTertiary">#7D5260</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFD8E4</item>
        <item name="colorOnTertiaryContainer">#31111D</item>

        <!-- Status bar and Nav bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Force toolbar icon color -->
        <item name="toolbarNavigationButtonStyle">@style/ToolbarButtonIconStyle</item>
    </style>

    <style name="ToolbarButtonIconStyle" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="android:tint">?attr/colorOnPrimary</item>
    </style>

    <style name="Theme.TravelExpenseTracker" parent="Base.Theme.TravelExpenseTracker" />
</resources>
